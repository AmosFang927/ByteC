{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ByteC/skills/self-improving/hooks/observe.sh post_tool \"$(jq -r '.tool_name' 2>/dev/null)\" \"$(jq -c '.tool_input' 2>/dev/null)\" \"$(jq -c '.tool_response' 2>/dev/null)\" 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}
